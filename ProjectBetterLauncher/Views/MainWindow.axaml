<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProjectBetterLauncher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:ProjectBetterLauncher.Views"
        Loaded="MainWindow_OnLoaded"
        mc:Ignorable="d" 
        d:DesignWidth="1200" 
        d:DesignHeight="800"
        x:Class="ProjectBetterLauncher.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/icon.ico"
        Title="Project: Better"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Foreground="Transparent"
        FontFamily="{StaticResource VCR}"
        WindowDecorations="BorderOnly">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Panel>
        <UserControl>
            <UserControl.Styles>
                <Style Selector="Image.bg">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                        </Setter.Value>
                    </Setter>

                    <Setter Property="RenderTransformOrigin" Value="50%,50%"/>

                    <Style.Animations>
                        <Animation
                            Duration="0:0:20"
                            IterationCount="Infinite"
                            PlaybackDirection="Alternate"
                            Easing="SineEaseInOut">

                            <KeyFrame Cue="0%">
                                <Setter Property="ScaleTransform.ScaleX" Value="1.2"/>
                                <Setter Property="ScaleTransform.ScaleY" Value="1.2"/>
                                <Setter Property="TranslateTransform.X" Value="-15"/>
                                <Setter Property="TranslateTransform.Y" Value="20"/>
                                <Setter Property="RotateTransform.Angle" Value="-2"/>
                            </KeyFrame>
                            <KeyFrame Cue="50%">
                                <Setter Property="TranslateTransform.X" Value="25"/>
                                <Setter Property="TranslateTransform.Y" Value="25"/>
                                <Setter Property="RotateTransform.Angle" Value="3"/>
                            </KeyFrame>
                            <KeyFrame Cue="100%">
                                <Setter Property="ScaleTransform.ScaleX" Value="1.4"/>
                                <Setter Property="ScaleTransform.ScaleY" Value="1.4"/>
                                <Setter Property="TranslateTransform.X" Value="15"/>
                                <Setter Property="TranslateTransform.Y" Value="20"/>
                                <Setter Property="RotateTransform.Angle" Value="2"/>
                            </KeyFrame>

                        </Animation>
                    </Style.Animations>
                </Style>
            </UserControl.Styles>
            
            <Image
                Classes="bg"
                Name="BackgroundImage"
                Source="avares://ProjectBetterLauncher/Assets/defaultbackground.jpg"
                Stretch="UniformToFill"
                IsHitTestVisible="False"
                />
        </UserControl>
        
        <Border Background="rgba(0,0,0,0.55)"
                BorderBrush="rgba(255,255,255,0.25)"
                BorderThickness="2"
                Padding="8, 4"
                Margin="12"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom">
            <TextBlock TextElement.FontFamily="{StaticResource VCR}" 
                       FontSize="11"
                       Foreground="White">
                v0.0.1af1
            </TextBlock>
        </Border>

        <StackPanel VerticalAlignment="Center" 
                    HorizontalAlignment="Center"
                    Spacing="10">
            
            <Image
                Source="avares://ProjectBetterLauncher/Assets/PJBTLogo.png"
                Width="600"
                Margin="-60, -60, -60, -45">
                <Image.Effect>
                    <DropShadowEffect BlurRadius="15" Color="Black" Opacity="0.85"></DropShadowEffect>
                </Image.Effect>
            </Image>

            <Border BorderBrush="White"
                    IsVisible="True"
                    Name="PlayButton"
                    BorderThickness="3" 
                    Width="400">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Color="Black" Opacity="0.8"/>
                </Border.Effect>
                <Border.Styles>
                    <Style Selector="Border">
                        <Setter Property="RenderTransform" Value="scale(1)"/>
                        <Setter Property="Transitions">
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0" Easing="CubicEaseInOut"/>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseInOut"/>
                            </Transitions>
                        </Setter>
                    </Style>

                    <Style Selector="Border:pointerover">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="RenderTransform" Value="scale(1.08)"/>
                    </Style>
                </Border.Styles>
                <Panel>
                    <Button Name="PlayButtonAction"
                            Foreground="White" 
                            Click="PlayButton_Click" 
                            PointerEntered="InputElement_OnPointerEntered"
                            CornerRadius="0" 
                            Cursor="Hand"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" 
                            VerticalContentAlignment="Center"
                            Background="Black" 
                            VerticalAlignment="Center" 
                            Height="44"
                            FontSize="20"
                            TextElement.FontFamily="{StaticResource VCR}">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Foreground" Value="White"></Setter>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Foreground" Value="Black"></Setter>
                            </Style>
                            <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Foreground" Value="White"></Setter>
                                <Setter Property="Background" Value="Black"></Setter>
                            </Style>
                            <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="#2B2B2B"></Setter>
                                <Setter Property="Foreground" Value="#A0A0A0"></Setter>
                            </Style>
                        </Button.Styles>
                        Checking...
                    </Button>
                </Panel>
            </Border>
            
            <Border BorderBrush="White"
                    IsVisible="False"
                    Name="StopButton"
                    BorderThickness="3" 
                    Width="400">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" Color="Black" Opacity="0.8"/>
                </Border.Effect>
                <Border.Styles>
                    <Style Selector="Border">
                        <Setter Property="RenderTransform" Value="scale(1)"/>
                        <Setter Property="Transitions">
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0" Easing="CubicEaseInOut"/>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseInOut"/>
                            </Transitions>
                        </Setter>
                    </Style>

                    <Style Selector="Border:pointerover">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="RenderTransform" Value="scale(1.08)"/>
                    </Style>
                </Border.Styles>
                <Panel>
                    <Button Foreground="White" 
                            Click="CloseTheGame_OnClick" 
                            PointerEntered="InputElement_OnPointerEntered"
                            Cursor="Hand"
                            Name="CloseTheGame"
                            CornerRadius="0" 
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" 
                            VerticalContentAlignment="Center"
                            Background="#FF1E1E" 
                            VerticalAlignment="Center" 
                            Height="44"
                            FontSize="20"
                            TextElement.FontFamily="{StaticResource VCR}">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Foreground" Value="White"></Setter>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Foreground" Value="Black"></Setter>
                            </Style>
                            <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Foreground" Value="White"></Setter>
                                <Setter Property="Background" Value="#CC0000"></Setter>
                            </Style>
                        </Button.Styles>
                        Close The Game
                    </Button>
                </Panel>
            </Border>

            <Border Name="DownloadProgressBorder"
                    BorderBrush="White"
                    BorderThickness="3"
                    Width="400"
                    Height="30"
                    Margin="0,2,0,0"
                    Background="Black"
                    IsVisible="False">
                <Panel>
                    <ProgressBar Name="DownloadProgressBar"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Height="24"
                                 CornerRadius="0"
                                 Background="Black"
                                 Foreground="White"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch" />
                    <TextBlock Name="DownloadProgressText"
                               Text="0%"
                               FontFamily="{StaticResource VCR}"
                               FontSize="14"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="4" Color="Black" OffsetX="1" OffsetY="1"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </Panel>
            </Border>
        
            <Border Background="rgba(0,0,0,0.6)"
                    BorderBrush="rgba(255,255,255,0.25)"
                    BorderThickness="2"
                    Padding="16, 8"
                    HorizontalAlignment="Center">
                <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <TextBlock TextElement.FontFamily="{StaticResource Cartoon}" 
                               Foreground="White" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Name="StatusText"
                               FontSize="10">
                        Checking for updates...
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="5" OffsetX="0" OffsetY="0"></DropShadowEffect>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock TextElement.FontFamily="{StaticResource Cartoon}" 
                               Foreground="Yellow" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center" 
                               Name="VersionText"
                               FontSize="9">
                        Newest version: LOADING
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="5" OffsetX="0" OffsetY="0"></DropShadowEffect>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
        
        <StackPanel Name="BottomLeftButtonsPanel"
                    Orientation="Horizontal" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Bottom"
                    Margin="12"
                    Spacing="10">
            <Border BorderBrush="White" 
                    Name="OpenSettingsBorder"
                    IsVisible="True"
                    BorderThickness="3" 
                    Width="40"
                    Height="36">
                <Border.Styles>
                    <Style Selector="Border">
                        <Setter Property="RenderTransform" Value="scale(1)"/>
                        <Setter Property="Transitions">
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0" Easing="CubicEaseInOut"/>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseInOut"/>
                            </Transitions>
                        </Setter>
                    </Style>

                    <Style Selector="Border:pointerover">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="RenderTransform" Value="scale(1.1)"/>
                    </Style>
                </Border.Styles>
                <Panel>
                    <Button Foreground="White" 
                            Click="OpenSettings_Click"
                            PointerEntered="InputElement_OnPointerEntered"
                            Cursor="Hand"
                            CornerRadius="0" 
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" 
                            VerticalContentAlignment="Center"
                            Background="Black" 
                            VerticalAlignment="Center" 
                            Height="30"
                            FontSize="10"
                            TextElement.FontFamily="{StaticResource VCR}">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Foreground" Value="White"></Setter>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Foreground" Value="Black"></Setter>
                            </Style>
                            <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Foreground" Value="White"></Setter>
                                <Setter Property="Background" Value="Black"></Setter>
                            </Style>
                        </Button.Styles>
                        <Image 
                            Source="avares://ProjectBetterLauncher/Assets/icon.ico"
                            Margin="-7"
                            ></Image>
                    </Button>
                </Panel>
            </Border>

            <Border BorderBrush="White" 
                    Name="OpenChangelogBorder"
                    IsVisible="True"
                    BorderThickness="3" 
                    Width="130"
                    Height="36">
                <Border.Styles>
                    <Style Selector="Border">
                        <Setter Property="RenderTransform" Value="scale(1)"/>
                        <Setter Property="Transitions">
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0" Easing="CubicEaseInOut"/>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseInOut"/>
                            </Transitions>
                        </Setter>
                    </Style>

                    <Style Selector="Border:pointerover">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="RenderTransform" Value="scale(1.08)"/>
                    </Style>
                </Border.Styles>
                <Panel>
                    <Button Foreground="White" 
                            Click="OpenChangelog_Click"
                            PointerEntered="InputElement_OnPointerEntered"
                            Cursor="Hand"
                            CornerRadius="0" 
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" 
                            VerticalContentAlignment="Center"
                            Background="Black" 
                            VerticalAlignment="Center" 
                            Height="30"
                            FontSize="13"
                            TextElement.FontFamily="{StaticResource VCR}">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Foreground" Value="White"></Setter>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Foreground" Value="Black"></Setter>
                            </Style>
                            <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Foreground" Value="White"></Setter>
                                <Setter Property="Background" Value="Black"></Setter>
                            </Style>
                        </Button.Styles>
                        Changelog
                    </Button>
                </Panel>
            </Border>
        </StackPanel>

        <views:Settings IsVisible="False" Name="Settings"></views:Settings>
        <views:Changelog IsVisible="False" Name="Changelog"></views:Changelog>
        <views:HowToInstall IsVisible="False" Name="HowToInstall"></views:HowToInstall>
        <views:Opinion Name="Opinion" IsVisible="False"></views:Opinion>
    </Panel>
</Window>