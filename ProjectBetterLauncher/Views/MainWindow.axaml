<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProjectBetterLauncher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:ProjectBetterLauncher.Views"
        Loaded="MainWindow_OnLoaded"
        mc:Ignorable="d" 
        d:DesignWidth="800" 
        d:DesignHeight="450"
        x:Class="ProjectBetterLauncher.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/icon.ico"
        Title="Project: Better"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        Foreground="Transparent"
        FontFamily="{StaticResource VCR}">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Panel>
        <UserControl>
            <UserControl.Styles>
                <Style Selector="Image.bg">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                        </Setter.Value>
                    </Setter>

                    <Setter Property="RenderTransformOrigin" Value="50%,50%"/>

                    <Style.Animations>
                        <Animation
                            Duration="0:0:20"
                            IterationCount="Infinite"
                            PlaybackDirection="Alternate"
                            Easing="SineEaseInOut">

                            <KeyFrame Cue="0%">
                                <Setter Property="ScaleTransform.ScaleX" Value="1.2"/>
                                <Setter Property="ScaleTransform.ScaleY" Value="1.2"/>
                                <Setter Property="TranslateTransform.X" Value="-15"/>
                                <Setter Property="TranslateTransform.Y" Value="20"/>
                                <Setter Property="RotateTransform.Angle" Value="-2"/>
                            </KeyFrame>
                            <KeyFrame Cue="50%">
                                <Setter Property="TranslateTransform.X" Value="25"/>
                                <Setter Property="TranslateTransform.Y" Value="25"/>
                                <Setter Property="RotateTransform.Angle" Value="3"/>
                            </KeyFrame>
                            <KeyFrame Cue="100%">
                                <Setter Property="ScaleTransform.ScaleX" Value="1.4"/>
                                <Setter Property="ScaleTransform.ScaleY" Value="1.4"/>
                                <Setter Property="TranslateTransform.X" Value="15"/>
                                <Setter Property="TranslateTransform.Y" Value="20"/>
                                <Setter Property="RotateTransform.Angle" Value="2"/>
                            </KeyFrame>

                        </Animation>
                    </Style.Animations>
                </Style>
            </UserControl.Styles>
            
            <Image
                Classes="bg"
                Name="background"
                Source="avares://ProjectBetterLauncher/Assets/defaultbackground.jpg"
                Stretch="UniformToFill"
                IsHitTestVisible="False"
                />
        </UserControl>
        
        <TextBlock TextElement.FontFamily="{StaticResource VCR}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Bottom">v0.0.1</TextBlock>

        <StackPanel VerticalAlignment="Center" 
                HorizontalAlignment="Center">
            
                <Image
                    Source="avares://ProjectBetterLauncher/Assets/PJBTLogo.png"
                    Width="600"
                    Margin="-60"
            >
                    <Image.Effect>
                        <DropShadowEffect></DropShadowEffect>
                    </Image.Effect>
                </Image>
            <!-- Button Start -->
            <Border BorderBrush="White"
                    IsVisible="True"
                    Name="PlayButton"
                    BorderThickness="3" 
                    Width="400">
                <Border.Styles>
                    <Style Selector="Border">
                        <Setter Property="RenderTransform" Value="scale(1)"/>
                        <Setter Property="Transitions">
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0" Easing="CubicEaseInOut"/>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseInOut"/>
                            </Transitions>
                        </Setter>
                    </Style>

                    <Style Selector="Border:pointerover">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="RenderTransform" Value="scale(1.1)"/>
                    </Style>
                </Border.Styles>
                <Panel>
                    <Button Foreground="White" 
                            Click="PlayButton_Click" 
                            PointerEntered="InputElement_OnPointerEntered"
                            CornerRadius="0" 
                            Cursor="Hand"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" 
                            VerticalContentAlignment="Center"
                            Background="Black" 
                            VerticalAlignment="Center" 
                            Height="40"
                            FontSize="20"
                            TextElement.FontFamily="{StaticResource VCR}">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Foreground" Value="White"></Setter>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Foreground" Value="Black"></Setter>
                            </Style>
                            <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Foreground" Value="White"></Setter>
                                <Setter Property="Background" Value="Black"></Setter>
                            </Style>
                        </Button.Styles>
                        Play
                    </Button>
                </Panel>
            </Border>
            
            <!-- Button End -->
            
            <Border BorderBrush="White"
                    IsVisible="False"
                    Name="StopButton"
                    BorderThickness="3" 
                    Width="400">
                <Border.Styles>
                    <Style Selector="Border">
                        <Setter Property="RenderTransform" Value="scale(1)"/>
                        <Setter Property="Transitions">
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0" Easing="CubicEaseInOut"/>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseInOut"/>
                            </Transitions>
                        </Setter>
                    </Style>

                    <Style Selector="Border:pointerover">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="RenderTransform" Value="scale(1.1)"/>
                    </Style>
                </Border.Styles>
                <Panel>
                    <Button Foreground="White" 
                            Click="CloseTheGame_OnClick" 
                            PointerEntered="InputElement_OnPointerEntered"
                            Cursor="Hand"
                            Name="CloseTheGame"
                            CornerRadius="0" 
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" 
                            VerticalContentAlignment="Center"
                            Background="Red" 
                            VerticalAlignment="Center" 
                            Height="40"
                            FontSize="20"
                            TextElement.FontFamily="{StaticResource VCR}">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Foreground" Value="White"></Setter>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Foreground" Value="Black"></Setter>
                            </Style>
                            <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Foreground" Value="White"></Setter>
                                <Setter Property="Background" Value="Red"></Setter>
                            </Style>
                        </Button.Styles>
                        Close The Game
                    </Button>
                </Panel>
            </Border>
        
            <TextBlock TextElement.FontFamily="{StaticResource Cartoon}" 
                       Foreground="White" 
                       Margin="5" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       Name="StatusText"
                       FontSize="10">
                Press "Play" to launch the game!
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="5" OffsetX="0" OffsetY="0"></DropShadowEffect>
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>
        
        <Panel HorizontalAlignment="Left" VerticalAlignment="Bottom">
            <Border BorderBrush="White" 
                    Margin="10"
                    Name="OpenSettingsBorder"
                    IsVisible="True"
                    BorderThickness="3" 
                    Width="40"
                    Height="35">
                <Border.Styles>
                    <Style Selector="Border">
                        <Setter Property="RenderTransform" Value="scale(1)"/>
                        <Setter Property="Transitions">
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0" Easing="CubicEaseInOut"/>
                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseInOut"/>
                            </Transitions>
                        </Setter>
                    </Style>

                    <Style Selector="Border:pointerover">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="RenderTransform" Value="scale(1.1)"/>
                    </Style>
                </Border.Styles>
                <Panel>
                    <Button Foreground="White" 
                            Click="OpenSettings_Click"
                            PointerEntered="InputElement_OnPointerEntered"
                            Cursor="Hand"
                            CornerRadius="0" 
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" 
                            VerticalContentAlignment="Center"
                            Background="Black" 
                            VerticalAlignment="Bottom" 
                            Height="30"
                            FontSize="10"
                            TextElement.FontFamily="{StaticResource VCR}">
                        <Button.Styles>
                            <Style Selector="Button">
                                <Setter Property="Foreground" Value="White"></Setter>
                            </Style>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Foreground" Value="Black"></Setter>
                            </Style>
                            <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Foreground" Value="White"></Setter>
                                <Setter Property="Background" Value="Black"></Setter>
                            </Style>
                        </Button.Styles>
                        <Image 
                            Source="avares://ProjectBetterLauncher/Assets/icon.ico"
                            Margin="-7"
                            ></Image>
                    </Button>
                </Panel>
            </Border>
        </Panel>
        <views:Settings IsVisible="False" Name="Settings"></views:Settings>
    </Panel>
</Window>