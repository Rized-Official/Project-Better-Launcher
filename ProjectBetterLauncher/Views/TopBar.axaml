<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ProjectBetterLauncher.Views.TopBar"
             FontFamily="{StaticResource VCR}">

    <UserControl.Styles>
        <Style Selector="Button.windowBtn">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="rgba(0, 0, 0, 0.5)"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.windowBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style Selector="Button.windowBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="LightGray"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>

        <Style Selector="Button.closeBtn">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="#FF1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.closeBtn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#FF1E1E"/>
        </Style>

        <Style Selector="Button.closeBtn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#CC0000"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Styles>
    
    <Panel VerticalAlignment="Top" Height="30">
        <Border WindowDecorationProperties.ElementRole="TitleBar"
                Background="rgba(0, 0, 0, 0.25)"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsHitTestVisible="True"/>

        <Border Background="rgba(0, 0, 0, 0.35)"
                Padding="12, 0"
                Height="30"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                IsHitTestVisible="False">
            <TextBlock Foreground="White"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Text="Project: Better">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="4" Color="Black" OffsetX="1" OffsetY="1"/>
                </TextBlock.Effect>
            </TextBlock>
        </Border>

        <Border Background="rgba(0, 0, 0, 0.35)"
                MinWidth="190"
                Height="30"
                Padding="16, 0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center" 
                        Spacing="6">
                <TextBlock Foreground="White"
                           FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Name="LauncherStateText"
                           Text="Launching...">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="4" Color="Black" OffsetX="1" OffsetY="1"/>
                    </TextBlock.Effect>
                </TextBlock>
                <Image Source="avares://ProjectBetterLauncher/Assets/icon.ico" 
                       Width="15" 
                       Height="15" 
                       VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top">
            <Button Classes="windowBtn" 
                    Click="Minimize_OnClick" 
                    ClipToBounds="False">
                <TextBlock FontFamily="{StaticResource Cartoon}"
                           FontSize="12"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Text="-">
                    <TextBlock.RenderTransform>
                        <TranslateTransform Y="-1.5"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Button>

            <Button Classes="windowBtn" 
                    Click="Maximize_OnClick" 
                    ClipToBounds="False">
                <TextBlock FontFamily="{StaticResource Cartoon}"
                           FontSize="11"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Text="■">
                    <TextBlock.RenderTransform>
                        <TranslateTransform Y="-1.5"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Button>

            <Button Classes="closeBtn" 
                    Click="CloseLauncher_OnClick" 
                    ClipToBounds="False">
                <TextBlock FontFamily="{StaticResource Cartoon}"
                           FontSize="11"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           Text="X">
                    <TextBlock.RenderTransform>
                        <TranslateTransform Y="-1.5"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Button>
        </StackPanel>
    </Panel>
</UserControl>